<?xml version="1.0" encoding="utf-8"?>
<!--
  Demo screen. Deliberately plain: flat layouts, no animation, 56dp touch targets for gloved use
  (NFR-504). The full screen set in DES-09 is Day 9 of the roadmap proper.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bifrǫst"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/serverStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Starting…"
        android:textSize="15sp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PAIRED PRINTERS"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <!-- Bonded devices only. Pairing is delegated to Android settings (FR-401). -->
    <Spinner
        android:id="@+id/printerSpinner"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Connect" />

    <Button
        android:id="@+id/probeButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Identify printer language" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Identify sends a visible ESC/POS test line. Watch whether paper moves."
        android:textSize="12sp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready."
            android:textSize="13sp"
            android:typeface="monospace" />
    </ScrollView>

</LinearLayout>
