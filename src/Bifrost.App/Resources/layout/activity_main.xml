<?xml version="1.0" encoding="utf-8"?>
<!--
  Demo screen. Deliberately plain: flat layouts, no animation, 56dp touch targets for gloved use
  (NFR-504). The full screen set in DES-09 is Day 9 of the roadmap proper.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bifrǫst"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/serverStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Starting…"
        android:textSize="15sp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

    <!--
      Battery-optimisation warning. Hidden when exempt, so its presence always means something.
      R-03: this is the most likely cause of a connection that dies silently in the field.
    -->
    <LinearLayout
        android:id="@+id/batteryWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFF3E0"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ Battery optimisation is on"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#E65100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android may switch the printer connection off in the background. Set Bifrǫst to Unrestricted."
            android:textSize="13sp"
            android:paddingTop="4dp" />

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Open battery settings" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PAIRED PRINTERS"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <!-- Bonded devices only. Pairing is delegated to Android settings (FR-401). -->
    <Spinner
        android:id="@+id/printerSpinner"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <!-- Connect also checks the language and fills the list below (FR-607). -->
    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Connect" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PRINTER LANGUAGE"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <!-- Filled after Connect, from what the printer reported. -->
    <Spinner
        android:id="@+id/languageSpinner"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <Button
        android:id="@+id/switchButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Switch language (reconnects)" />

    <!--
      FR-402. Proves the whole path without a web page in it, which is what separates
      "Bluetooth does not work" from "the web integration does not work".
    -->
    <Button
        android:id="@+id/testPrintButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Test print (text, barcode, QR, image)" />

    <!--
      The ZQ320 printed every byte it was sent as literal text, which is what a Zebra does when
      device.languages is line_print. No driver can work until that is changed.
    -->
    <Button
        android:id="@+id/sgdButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Zebra: force device.languages to CPCL" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Forcing the language needs a printer power-cycle to take effect."
        android:textSize="12sp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready."
            android:textSize="13sp"
            android:typeface="monospace" />
    </ScrollView>

</LinearLayout>
